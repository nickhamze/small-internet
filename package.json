{
  "name": "small-internet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A free Astro theme for your own place on the internet.",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "assets": "node --experimental-strip-types scripts/generate-assets.ts",
    "predev": "npm run assets",
    "predemo": "npm run assets",
    "prebuild": "npm run assets",
    "format": "prettier --write \"src/**/*\" \"scripts/*.{mjs,ts}\" astro.config.mjs tsconfig.json package.json .prettierrc.mjs .github/workflows/ci.yml",
    "format:check": "prettier --check \"src/**/*\" \"scripts/*.{mjs,ts}\" astro.config.mjs tsconfig.json package.json .prettierrc.mjs .github/workflows/ci.yml",
    "verify:static": "node scripts/verify-static.mjs",
    "verify:behavior": "node scripts/verify-behavior.mjs",
    "verify:authoring": "node scripts/verify-authoring.mjs",
    "verify:brand": "node scripts/verify-brand.mjs",
    "verify": "npm run check && npm run format:check && npm run build && npm run verify:static && npm run verify:behavior && npm run verify:brand && npm run verify:authoring"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
