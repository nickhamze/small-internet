---
interface Props {
  kind?: string;
}
const { kind = 'book' } = Astro.props;
---

<svg
  class="icon"
  width="28"
  height="28"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {kind === 'leaf' ? (
    <>
      <path d="M19 3C9 2 4 7 5 14c6 2 13-2 14-11Z" />
      <path d="M3 21 16 7" />
    </>
  ) : kind === 'tool' ? (
    <>
      <path d="M14 6a5 5 0 0 0-6 6l-5 5 4 4 5-5a5 5 0 0 0 6-6l-3 3-4-4Z" />
    </>
  ) : kind === 'music' ? (
    <>
      <path d="M8 17V5l12-2v12M8 8l12-2" />
      <circle cx="5" cy="18" r="3" />
      <circle cx="17" cy="16" r="3" />
    </>
  ) : kind === 'arrow' ? (
    <>
      <path d="M5 12h14m-6-6 6 6-6 6" />
    </>
  ) : (
    <>
      <path d="M12 6v15M3 3c4-1 7 0 9 3 2-3 5-4 9-3v16c-4-1-7 0-9 2-2-2-5-3-9-2Z" />
    </>
  )}
</svg>
