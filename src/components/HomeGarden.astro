---
import { garden } from '../data/garden';
import ExternalTitle from './ExternalTitle.astro';
import Icon from './Icon.astro';
---

<section class="home-garden paper-panel">
  <div class="section-heading">
    <h2>
      <span class="personal-heading notebook-heading">Go Spacefast</span>
      <span class="garden-heading">Plant it online</span>
    </h2>
    <a href="/garden/">Find your way →</a>
  </div>
  <p class="section-aside">Your next good click. The computer insists.</p>
  <ul class="garden-list">
    {garden.slice(0, 3).map((link, i) => (
      <li class="garden-row">
        <span class={`link-number number-${i}`} aria-hidden="true">
          {i + 1}
        </span>
        <div>
          <a href={link.href}>
            <ExternalTitle title={link.title} />
          </a>
          <span class="garden-category">{link.category}</span>
          <p>{link.description}</p>
          <a class="garden-visit" href={link.href}>
            Go there <span aria-hidden="true">↗</span>
          </a>
        </div>
        <span class="tag">{link.category}</span>
        <span class="garden-leaf-corner" aria-hidden="true">
          <Icon kind="leaf" />
        </span>
      </li>
    ))}
  </ul>
</section>
