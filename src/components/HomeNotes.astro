---
import type { CollectionEntry } from 'astro:content';
interface Props {
  notes: CollectionEntry<'notes'>[];
}
const { notes } = Astro.props;
const format = (date: Date) =>
  date.toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<section class="home-notes paper-panel">
  <div class="section-heading">
    <h2>Latest notes</h2>
    <a href="/notes/">More notes →</a>
  </div>
  {notes.length ? (
    <ul class="notes-list">
      {notes.map((note) => (
        <li class="note-row">
          <div class="note-line">
            <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            <time datetime={note.data.date.toISOString()}>
              {format(note.data.date)}
            </time>
          </div>
          <p>{note.data.description}</p>
        </li>
      ))}
    </ul>
  ) : (
    <p>
      The notebook is empty for now. There’s room for the next small thought.
    </p>
  )}
</section>
