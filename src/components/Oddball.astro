---
import { site } from '../data/site';
---

<div class="hero-art">
  <div class="character-stage">
    {(['personal', 'notebook', 'garden'] as const).map((look) => (
      <img
        class={`mascot mascot-${look}`}
        src={`/assets/oddball-${look}.webp`}
        srcset={`/assets/oddball-${look}-320.webp 320w, /assets/oddball-${look}.webp 640w`}
        sizes="(max-width:760px) 320px, 420px"
        width="640"
        height="640"
        alt=""
        loading={site.defaultLook === look ? 'eager' : 'lazy'}
        decoding="async"
      />
    ))}
    <span class="character-note character-note-personal" aria-hidden="true">
      a very
      <br />
      small internet
    </span>
    <span class="character-note character-note-notebook" aria-hidden="true">
      good things
      <br />
      in here
    </span>
    <span class="character-note character-note-garden" aria-hidden="true">
      please do not
      <br />
      eat the links
    </span>
    <span class="boop-bubble" aria-hidden="true">
      BOOP!
    </span>
  </div>
  <button type="button" class="boop-button js-only">
    Boop the oddball
  </button>
  <span class="boop-status" role="status" aria-live="polite"></span>
</div>
<script>
  const stage = document.querySelector<HTMLElement>('.hero-art');
  if (stage) {
    const button = stage.querySelector<HTMLButtonElement>('button')!;
    const status = stage.querySelector<HTMLElement>('[role=status]')!;
    let timer: ReturnType<typeof setTimeout>;
    button.addEventListener('click', () => {
      clearTimeout(timer);
      stage.classList.remove('booped');
      void stage.offsetWidth;
      stage.classList.add('booped');
      status.textContent = 'Boop. The oddball approves.';
      timer = setTimeout(() => stage.classList.remove('booped'), 900);
    });
    button.classList.add('is-ready');
  }
</script>
