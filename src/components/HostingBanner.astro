---
import { site } from '../data/site';
const hosted = process.env.SPACEFAST_HOSTED === '1';
const preview = process.env.HOSTING_PREVIEW === '1' && !hosted;
const enabled = hosted || preview;
---

{enabled && (
  <aside
    id="hosting-banner"
    class="hosting-banner"
    aria-label={
      preview ? 'Spacefast hosting preview' : 'Spacefast hosting credit'
    }
    data-storage-key={`${site.storageId}:spacefast-dismissed`}
  >
    <div class="hosting-inner">
      <a
        class="host-brand"
        href="https://spacefast.com/"
        aria-label="Explore Spacefast"
      >
        <span>{preview ? 'Hosting preview' : 'Hosted on'}</span>
        <img
          src="/assets/spacefast-wordmark.svg"
          width="152"
          height="29"
          alt="Spacefast"
        />
      </a>
      <p class="host-copy">
        <strong>Your own place on the internet.</strong>
        <span>
          {preview
            ? 'Optional hosting for this free Astro theme.'
            : 'This little corner of the web is hosted on Spacefast.'}
        </span>
      </p>
      <a class="host-cta" href="https://spacefast.com/">
        <span class="desktop-label">Explore Spacefast</span>
        <span class="mobile-label">Explore</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.7"
          aria-hidden="true"
        >
          <path d="M5 15 15 5M5 5h10v10" />
        </svg>
      </a>
      <button class="host-close js-only" aria-label="Dismiss Spacefast banner">
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="m5 5 10 10M15 5 5 15" />
        </svg>
      </button>
    </div>
  </aside>
)}
<script>
  const banner = document.querySelector<HTMLElement>('#hosting-banner');
  if (banner) {
    const sync = () =>
      document.documentElement.style.setProperty(
        '--host-height',
        banner.hidden ? '0px' : `${banner.getBoundingClientRect().height}px`,
      );
    let dismissed = document.documentElement.dataset.hostDismissed === 'true';
    const syncKeyboard = () => {
      const editing = document.activeElement?.matches('input,textarea');
      const keyboard =
        editing &&
        window.visualViewport &&
        window.visualViewport.height < window.innerHeight * 0.75;
      banner.hidden =
        document.documentElement.dataset.hostDismissed === 'true' || !!keyboard;
      sync();
    };
    banner.hidden = dismissed;
    sync();
    window.visualViewport?.addEventListener('resize', syncKeyboard);
    document.addEventListener('focusin', syncKeyboard);
    document.addEventListener('focusout', syncKeyboard);
    new ResizeObserver(sync).observe(banner);
    banner
      .querySelector<HTMLButtonElement>('button')
      ?.addEventListener('click', () => {
        try {
          localStorage.setItem(banner.dataset.storageKey!, '1');
        } catch {
          /* Closing still works without storage. */
        }
        document.documentElement.dataset.hostDismissed = 'true';
        banner.hidden = true;
        sync();
        const target = document.querySelector<HTMLElement>('#main');
        target?.focus({ preventScroll: true });
      });
    banner.querySelector('button')?.classList.add('is-ready');
  }
</script>
