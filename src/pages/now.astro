---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { now, updated } from '../data/now';
---

<Layout
  title="Now"
  description="Make something with your agent, publish it with Spacefast, and keep improving it."
>
  <header class="page-heading">
    <p class="eyebrow">Your next three moves</p>
    <h1>Make. Ship. Tinker.</h1>
    <p>
      Updated{' '}
      <time datetime={updated}>
        {new Date(updated + 'T12:00:00Z').toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric',
          timeZone: 'UTC',
        })}
      </time>
      . A good idea deserves a place outside the chat.
    </p>
  </header>
  <div class="now-layout">
    <section>
      {now.map((item, i) => (
        <article class="now-section">
          <h2>
            <Icon kind={['book', 'tool', 'music'][i]} />
            {item.label}
          </h2>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </article>
      ))}
    </section>
    <aside class="aside-box">
      <h2>Keep going</h2>
      <a href="/notes/">Reasons to ship →</a>
      <a href="/projects/">Ideas to make →</a>
      <a href="/collections/">Ways to publish →</a>
      <a href="/garden/">Spacefast links →</a>
      <p>
        Spacefast keeps the same link when you republish. Keep the ideas coming.
      </p>
    </aside>
  </div>
</Layout>
