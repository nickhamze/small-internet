---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
interface Props {
  entry: CollectionEntry<'notes'>;
}
import Layout from '../../layouts/Layout.astro';
export async function getStaticPaths() {
  return (await getCollection('notes', (e) => !e.data.draft)).map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const all = (await getCollection('notes', (e) => !e.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const next = all[(all.findIndex((n) => n.id === entry.id) + 1) % all.length];
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="article">
    <a class="back-link" href="/notes/">
      ← All notes
    </a>
    <header>
      <p class="meta">
        {entry.data.category} ·{' '}
        <time datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
            timeZone: 'UTC',
          })}
        </time>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {next && next.id !== entry.id && (
      <div class="article-end">
        <p class="eyebrow">Another note</p>
        <a href={`/notes/${next.id}/`}>{next.data.title} →</a>
      </div>
    )}
  </article>
</Layout>
