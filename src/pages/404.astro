---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" noindex>
  <section class="page-heading">
    <p class="eyebrow">A wrong turn, a small detour</p>
    <h1>Nothing here just yet.</h1>
    <p>That page may have moved, or the address may have a typo.</p>
  </section>
  <p>
    <a class="button" href="/">
      Go home
    </a>
  </p>
  <p>
    <a href="/notes/">Or wander through the notes →</a>
  </p>
</Layout>
